set window-title-basename true
set window-title-page true

# zoom
map <C-i> zoom in
map <C-o> zoom out

# zoom and scroll step size
set zoom-step 1
set scroll-step 80

set advance-pages-per-row true
set show-hidden true
set continuous-hist-save true

set database "sqlite"
map <C-b> feedkeys ":bmark "
map i recolor
set adjust-open width

set statusbar-basename true
set statusbar-page-percent true
set statusbar-home-tilde true

set font "JetBrains Mono Regular 10"

# ==================================================
# Zathura - Catppuccin Mocha Black Edition
# ==================================================

set guioptions "sh"

# --------------------------------------------------
# Main document colors
# --------------------------------------------------

set default-bg "#000000"
set default-fg "#cdd6f4"

# --------------------------------------------------
# Recolor mode
# --------------------------------------------------

set recolor true
set recolor-keephue true
set recolor-lightcolor "rgba(0,0,0,0)"
set recolor-darkcolor "rgba(255,255,255,1)"
set recolor-reverse-video false

# --------------------------------------------------
# Status bar
# --------------------------------------------------

set statusbar-bg "#000000"
set statusbar-fg "#cdd6f4"

# --------------------------------------------------
# Input bar
# --------------------------------------------------

set inputbar-bg "#000000"
set inputbar-fg "#cdd6f4"

# --------------------------------------------------
# Notifications
# --------------------------------------------------

set notification-bg "#000000"
set notification-fg "#cdd6f4"

# --------------------------------------------------
# Completion menu
# --------------------------------------------------

set completion-bg "#000000"
set completion-fg "#cdd6f4"

set completion-group-bg "#000000"
set completion-group-fg "#89b4fa"

set completion-highlight-bg "#cba6f7"
set completion-highlight-fg "#000000"

# --------------------------------------------------
# Index / Table of Contents
# --------------------------------------------------

set index-bg "#000000"
set index-fg "#cdd6f4"

set index-active-bg "#cba6f7"
set index-active-fg "#000000"

# --------------------------------------------------
# Highlights
# --------------------------------------------------

set highlight-color rgba(69, 71, 90, 0.25)
set highlight-active-color rgba(203, 166, 247, 0.45)
set highlight-fg rgba(205,214,244,1)
# --------------------------------------------------
# Selection
# --------------------------------------------------

set selection-clipboard clipboard
